   "source": [
    "## 卷积的尺寸的计算\n",
    "H_out = floor((H_in + 2*padding - kernel_size) / stride) + 1\n",
    "\n",
    "## 转置卷积的计算\n",
    "H_out = (H_in - 1) * stride - 2*padding + kernel_size + output_padding\n",
    "\n",
    "## 输入的顺序：\n",
    "nn.Conv2d(in_channels, out_channels, kernel_size, stride=1, padding=0)"
   ],
